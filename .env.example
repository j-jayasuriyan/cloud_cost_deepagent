# ── Deployment account ────────────────────────────────────────────────────────
# Runs the app and invokes Bedrock. In a deployment these come from the EC2
# instance profile or ECS task role — leave them unset there.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SESSION_TOKEN=your-session-token
AWS_DEFAULT_REGION=us-east-1

# ── Analysed account ──────────────────────────────────────────────────────────
# Not configured here. Each signed-in user enters the access key, secret key and
# session token for the account they want to scan through the AWS Account panel
# in the UI. Those keys are held in memory for that login session only.

# ── Login ─────────────────────────────────────────────────────────────────────
# Defaults are Admin / Admin@123. Override in every deployment.
# AUTH_USERNAME=Admin
# AUTH_PASSWORD=Admin@123

# Set to false only for plain-HTTP local runs. Must stay true behind TLS.
# COOKIE_SECURE=true

# ── LangSmith tracing (optional — remove or leave blank to disable) ───────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=cloud-cost-advisor
